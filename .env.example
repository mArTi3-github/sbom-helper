# purl2repo settings
PURL2REPO_TIMEOUT=15.0
PURL2REPO_USE_CACHE=true
PURL2REPO_STRICT=false
PURL2REPO_NO_NETWORK=false

# uvicorn settings
UVICORN_HOST=0.0.0.0
UVICORN_PORT=8443

# SearXNG (внутренний веб-поиск для LLM-резолвера)
# Секрет генерируется один раз: openssl rand -hex 32
SEARXNG_SECRET=
SEARXNG_URL=http://searxng:8080
